    {
      "id": "a4e3ae91-d8f0-4f71-95bc-bc844f3bc30b",
      "name": "Prepare Account Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1072,
        -640
      ],
      "parameters": {
        "jsCode": "const tokens = $('Exchange Code For Tokens').first().json;\nconst session = $('Validate Auth Session').first().json;\nconst user = $json.data || {};\n\nif (!tokens.access_token) {\n  throw new Error('X token exchange did not return an access_token.');\n}\n\nconst consoleMatch=String(session.state||'').match(/^console\\.([a-z0-9_]{1,15})\\.[A-Za-z0-9_-]+$/);\nif(consoleMatch && String(user.username||'').toLowerCase()!==consoleMatch[1])throw new Error('The authorized X account does not match the client selected in Jess Console. Start authorization again using the correct account.');\n\nif (!user.id) {\n  throw new Error('X /2/users/me did not return a user id.');\n}\n\nconst expiresInSeconds = Number(tokens.expires_in || 0);\nconst expiresAt = expiresInSeconds > 0\n  ? new Date(Date.now() + expiresInSeconds * 1000).toISOString()\n  : null;\n\nreturn [{\n  json: {\n    telegram_chat_id: session.telegram_chat_id,\n    // T5: carried from \"X Auth Sessions\".client_id onto the account row.\n    client_id: session.client_id || null,\n    state: session.state,\n    code_verifier: session.code_verifier,\n    session_expires_at: session.session_expires_at,\n    x_user_id: String(user.id),\n    x_username: user.username || '',\n    access_token: tokens.access_token,\n    refresh_token: tokens.refresh_token || '',\n    expires_at: expiresAt,\n    scope: tokens.scope || '',\n    updated_at: new Date().toISOString(),\n  },\n}];"
      }
    },
