      "id": "dccd843b-5736-4148-b170-6b2ae46c12f7",
      "name": "Analyze Reply Sentiment",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.1,
      "position": [
        688,
        448
      ],
      "credentials": {
        "openAiApi": {
          "id": "Valu7LAYDqkPgcyU",
