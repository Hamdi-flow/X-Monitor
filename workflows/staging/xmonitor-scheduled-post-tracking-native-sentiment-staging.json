    {
      "parameters": {
        "jsCode": "const postsByConversation = new Map(\n  $('Keep Posts With 10+ Replies').all().map(item => [\n    String(item.json.conversation_id),\n    {\n      postId: String(item.json.id),\n      postText: String(item.json.text || '').replace(/\\s+/g, ' ').trim(),\n      userId: String(item.json.author_id),\n      repliesByText: new Map(),\n    },\n  ])\n);\n\nfor (const group of $('Get Replies').all()) {\n  for (const reply of group.json.data || []) {\n    const post = postsByConversation.get(String(reply.conversation_id));\n    if (!post || !reply.id) continue;\n\n    const text = String(reply.text || '').replace(/\\s+/g, ' ').trim();\n    const normalized = text.normalize('NFKC').toLocaleLowerCase('en-US');\n    const key = normalized || `__empty__:${reply.id}`;\n    const duplicateReplies = post.repliesByText.get(key) || [];\n    duplicateReplies.push({ id: String(reply.id), text });\n    post.repliesByText.set(key, duplicateReplies);\n  }\n}\n\nconst output = [];\nfor (const post of postsByConversation.values()) {\n  for (const duplicateReplies of post.repliesByText.values()) {\n    const representative = duplicateReplies[0];\n    const postContext = post.postText.slice(0, 500);\n    const replyText = representative.text.slice(0, 700);\n\n    output.push({\n      json: {\n        postId: post.postId,\n        postText: post.postText,\n        userId: post.userId,\n        duplicateReplies,\n        analysisText: `Original post:\\n${postContext}\\n\\nReply to classify:\\n${replyText}`,\n      },\n    });\n  }\n}\n\nreturn output;"
      },
