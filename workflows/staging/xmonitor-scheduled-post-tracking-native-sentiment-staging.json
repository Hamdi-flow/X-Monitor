    {
      "parameters": {
        "jsCode": "const posts = new Map();\n\nfor (const item of items) {\n  const data = item.json || {};\n  const sentiment = String(data.sentimentAnalysis?.category || '').toLowerCase();\n  if (!['positive', 'neutral', 'negative'].includes(sentiment)) continue;\n\n  const postId = String(data.postId || '');\n  if (!postId) continue;\n\n  if (!posts.has(postId)) {\n    posts.set(postId, {\n      postId,\n      postText: data.postText,\n      userId: data.userId,\n      replies: [],\n      positive_count: 0,\n      neutral_count: 0,\n      negative_count: 0,\n    });\n  }\n\n  const post = posts.get(postId);\n  const duplicates = Array.isArray(data.duplicateReplies) ? data.duplicateReplies : [];\n  for (const reply of duplicates) {\n    post.replies.push({\n      id: reply.id,\n      text: reply.text,\n      sentiment: sentiment[0].toUpperCase() + sentiment.slice(1),\n    });\n    post[`${sentiment}_count`] += 1;\n  }\n}\n\nconst analyzedPosts = [...posts.values()].map(post => {\n  post.comments_count = post.replies.length;\n  post.negative_ratio = post.comments_count > 0\n    ? post.negative_count / post.comments_count\n    : 0;\n  post.negative_percentage = Math.round(post.negative_ratio * 100);\n\n  post.overall_tag = 'Neutral';\n  if (post.positive_count > post.neutral_count && post.positive_count > post.negative_count) {\n    post.overall_tag = 'Positive';\n  } else if (post.negative_count > post.neutral_count && post.negative_count > post.positive_count) {\n    post.overall_tag = 'Negative';\n  }\n\n  return post;\n});\n\nreturn [{\n  json: {\n    posts: analyzedPosts.filter(post => post.negative_ratio >= 0.5),\n  },\n}];"
      },
