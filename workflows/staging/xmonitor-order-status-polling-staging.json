                                   ],
                      "parameters":  {
                                         "operation":  "executeQuery",
                                         "query":  "SELECT *\nFROM public.\"Order Info\"\nWHERE normalized_status IN (\u0027pending\u0027, \u0027in_progress\u0027)\n  AND next_check_at \u003c= now()\nORDER BY next_check_at ASC\nLIMIT 50;",
