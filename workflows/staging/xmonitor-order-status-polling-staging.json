                                         "text":  "=Order status update\n\nOrder ID: {{ $(\u0027Update Order Info Status\u0027).item.json.provider_order_id }}\nType: {{ $(\u0027Update Order Info Status\u0027).item.json.order_type }}\nPost: {{ $(\u0027Update Order Info Status\u0027).item.json.post_id }}\nStatus: {{ $(\u0027Update Order Info Status\u0027).item.json.normalized_status }}\nRemains: {{ $(\u0027Update Order Info Status\u0027).item.json.remains ?? \u0027unknown\u0027 }}",
                                         "additionalFields":  {
