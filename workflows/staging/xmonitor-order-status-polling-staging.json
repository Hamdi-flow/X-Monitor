                  {
                      "id":  "02d5d9c3-5a50-493a-a625-49891c650a19",
                      "name":  "Check Provider Order Status",
                      "type":  "n8n-nodes-base.httpRequest",
                      "typeVersion":  4.4,
                      "position":  [
                                       1000,
                                       300
                                   ],
                      "parameters":  {
                                         "method":  "POST",
                                         "url":  "={{ $json.apiUrl }}",
                                         "sendBody":  true,
                                         "contentType":  "form-urlencoded",
                                         "bodyParameters":  {
                                                                "parameters":  [
                                                                                   {
                                                                                       "name":  "key",
                                                                                       "value":  "={{ $json.apiKey }}"
                                                                                   },
                                                                                   {
                                                                                       "name":  "action",
                                                                                       "value":  "status"
                                                                                   },
                                                                                   {
                                                                                       "name":  "order",
                                                                                       "value":  "={{ $json.provider_order_id }}"
                                                                                   }
                                                                               ]
                                                            },
                                         "options":  {
                                                         "response":  {
                                                                          "response":  {
                                                                                           "neverError":  true,
                                                                                           "responseFormat":  "json"
                                                                                       }
                                                                      }
                                                     }
                                     }
                  },
                  {
                      "id":  "562a8a58-c652-4b36-9d11-a8830b6788f4",
                      "name":  "Normalize Provider Status",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       1240,
                                       300
                                   ],
                      "parameters":  {
                                         "jsCode":  "const order = $(\u0027Fetch Due Order Info Rows\u0027).all()[$itemIndex]?.json || {};\nconst response = $json || {};\nconst now = new Date().toISOString();\n\nfunction firstPresent(keys) {\n  for (const key of keys) {\n    if (response[key] !== undefined \u0026\u0026 response[key] !== null \u0026\u0026 response[key] !== \u0027\u0027) {\n      return response[key];\n    }\n  }\n  return null;\n}\n\nfunction toNumber(value) {\n  if (value === null || value === undefined || value === \u0027\u0027) return null;\n  const parsed = Number(String(value).replace(/[^0-9.-]/g, \u0027\u0027));\n  return Number.isFinite(parsed) ? parsed : null;\n}\n\nfunction toInteger(value) {\n  const parsed = toNumber(value);\n  return parsed === null ? null : Math.trunc(parsed);\n}\n\nfunction normalize(raw, hasError) {\n  if (hasError) return \u0027failed\u0027;\n  const value = String(raw || \u0027\u0027).trim().toLowerCase();\n  if (!value) return \u0027pending\u0027;\n  if (value.includes(\u0027complete\u0027)) return \u0027completed\u0027;\n  if (value.includes(\u0027partial\u0027)) return \u0027partial\u0027;\n  if (value.includes(\u0027cancel\u0027) || value.includes(\u0027refund\u0027)) return \u0027canceled\u0027;\n  if (value.includes(\u0027fail\u0027) || value.includes(\u0027reject\u0027) || value.includes(\u0027error\u0027)) return \u0027failed\u0027;\n  if (value.includes(\u0027progress\u0027) || value.includes(\u0027process\u0027)) return \u0027in_progress\u0027;\n  if (value.includes(\u0027pending\u0027) || value.includes(\u0027wait\u0027) || value.includes(\u0027queue\u0027)) return \u0027pending\u0027;\n  return \u0027pending\u0027;\n}\n\nconst providerStatus = String(firstPresent([\u0027status\u0027, \u0027Status\u0027, \u0027state\u0027, \u0027State\u0027]) || \u0027\u0027).trim();\nconst rawError = firstPresent([\u0027error\u0027, \u0027Error\u0027]);\nconst messageWithoutStatus = !providerStatus ? firstPresent([\u0027message\u0027, \u0027Message\u0027]) : null;\nconst errorMessage = rawError || messageWithoutStatus;\nconst normalizedStatus = normalize(providerStatus, Boolean(errorMessage));\nconst isFinal = [\u0027completed\u0027, \u0027partial\u0027, \u0027canceled\u0027, \u0027failed\u0027].includes(normalizedStatus);\nconst postStatus = [\u0027completed\u0027, \u0027partial\u0027].includes(normalizedStatus)\n  ? \u0027Done\u0027\n  : [\u0027canceled\u0027, \u0027failed\u0027].includes(normalizedStatus)\n    ? \u0027Order Failed\u0027\n    : \u0027Processing\u0027;\n\nreturn [{\n  json: {\n    order_info_id: order.id,\n    provider: order.provider,\n    provider_order_id: order.provider_order_id,\n    order_type: order.order_type,\n    post_id: order.post_id,\n    telegram_chat_id: order.telegram_chat_id,\n    previous_normalized_status: order.normalized_status,\n    provider_status: providerStatus || (errorMessage ? \u0027Error\u0027 : \u0027Pending\u0027),\n    normalized_status: normalizedStatus,\n    post_status: postStatus,\n    status_response: response,\n    charge: toNumber(firstPresent([\u0027charge\u0027, \u0027Charge\u0027])),\n    start_count: toInteger(firstPresent([\u0027start_count\u0027, \u0027startCount\u0027, \u0027Start count\u0027, \u0027Start Count\u0027])),\n    remains: toInteger(firstPresent([\u0027remains\u0027, \u0027Remains\u0027])),\n    currency: firstPresent([\u0027currency\u0027, \u0027Currency\u0027]) ? String(firstPresent([\u0027currency\u0027, \u0027Currency\u0027])) : null,\n    last_error: errorMessage ? String(errorMessage) : null,\n    is_final: isFinal,\n    checked_at: now,\n  },\n}];"
                                     }
                  },
                  {
                      "id":  "da1860c7-71ac-4778-8c15-a1daa2290f7d",
                      "name":  "Update Order Info Status",
                      "type":  "n8n-nodes-base.postgres",
                      "typeVersion":  2.6,
                      "position":  [
                                       1480,
                                       300
                                   ],
                      "parameters":  {
                                         "operation":  "executeQuery",
                                         "query":  "UPDATE public.\"Order Info\"\nSET\n  provider_status = $2,\n  normalized_status = $3,\n  status_response = $4::jsonb,\n  -- Provider NULL means \"did not tell us\": keep the last known value instead of erasing it.\n  -- coalesce(0, remains) is still 0, so a countdown to zero is unaffected.\n  charge = coalesce($5::numeric, charge),\n  start_count = coalesce($6::integer, start_count),\n  remains = coalesce($7::integer, remains),\n  currency = coalesce($8, currency),\n  poll_attempts = poll_attempts + 1,\n  last_checked_at = now(),\n  next_check_at = CASE\n    WHEN $3 IN (\u0027completed\u0027, \u0027partial\u0027, \u0027canceled\u0027, \u0027failed\u0027) THEN next_check_at\n    ELSE now() + interval \u002730 minutes\u0027\n  END,\n  last_error = $9,\n  completed_at = CASE\n    WHEN $3 IN (\u0027completed\u0027, \u0027partial\u0027, \u0027canceled\u0027, \u0027failed\u0027) THEN COALESCE(completed_at, now())\n    ELSE completed_at\n  END\nWHERE id = $1::uuid\nRETURNING *;",
                                         "options":  {
                                                         "queryBatching":  "independently",
                                                         "queryReplacement":  "={{ [$json.order_info_id, $json.provider_status, $json.normalized_status, JSON.stringify($json.status_response), $json.charge, $json.start_count, $json.remains, $json.currency, $json.last_error] }}"
                                                     }
                                     },
                      "credentials":  {
                                          "postgres":  {
                                                           "id":  "CyXakOvvENeDwRue",
                                                           "name":  "Supabase Staging Postgres"
                                                       }
                                      }
                  },
                  {
