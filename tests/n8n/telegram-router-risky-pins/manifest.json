{
  "workflowId": "oLwwjO05IcRjtF8E",
  "workflowName": "XMonitor - Telegram Router Staging",
  "nodeSettingsAssertions": {
    "why": "SMMWiz add is not idempotent and has no cancel endpoint. An HTTP timeout does not mean the request failed to arrive - if it reached SMMWiz the order exists and is already charged, so a retry places and charges a SECOND real order. retryOnFail must stay false, and it is pinned explicitly rather than left to the n8n default so that a node typeVersion bump or a well-meaning edit fails this assertion instead of a client balance.",
    "setOn": "2026-08-25",
    "enforcedBy": "tests/n8n/telegram-router-retry-guard.test.mjs",
    "workflows": [
      {
        "id": "oLwwjO05IcRjtF8E",
        "name": "XMonitor - Telegram Router Staging"
      },
      {
        "id": "cWczsttyDbTBbRAC",
        "name": "XMonitor - Telegram Router"
      }
    ],
    "nodes": [
      {
        "name": "Place Comment Order",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.4,
        "retryOnFail": false
      },
      {
        "name": "Place Likes Order",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.4,
        "retryOnFail": false
      }
    ],
    "stickyNotes": [
      "Why Place Comment Order Must Not Retry",
      "Why Place Likes Order Must Not Retry"
    ]
  },
  "fixtures": [
    {
      "id": "hide-replies-enqueue",
      "file": "hide-replies-enqueue.pinData.json",
      "input": "callback_query.data=hide_pct:9990000000000000007:100; four Negative replies with status New, null, hidden, hide_failed plus one Neutral and one Positive",
      "riskPinned": [
        "Resolve Caller Authorization",
        "Get Post For Hide",
        "Get X Auth Account",
        "Get Replies For Post",
        "Enqueue Hide Requests",
        "Send Hide Queued Summary",
        "Store Queue Message Id"
      ],
      "expected": {
        "reaches": [
          "Validate Hide Percentage",
          "Build Hide Queue Items",
          "Enqueue Hide Requests",
          "Build Hide Queued Summary",
          "Send Hide Queued Summary",
          "Store Queue Message Id"
        ],
        "doesNotReach": [
          "Send No Replies"
        ],
        "asserts": [
          "Build Hide Queue Items counts 4 negative replies of 6 stored; the Neutral and Positive replies are never queued",
          "target_hidden=4 at 100%; the status=hidden negative counts toward it, New, null and hide_failed are queued oldest first -> submitted=3, locally_already_hidden=1",
          "Build Hide Queue Items emits ONE item carrying queued_rows_json plus a freshly minted batch_id",
          "Build Hide Queued Summary states the denominator (Target: 100% of 4 negative replies = 4 hidden) and Queued to hide: 3 (oldest first)",
          "Store Queue Message Id receives the sent message_id so the drain can edit that message"
        ],
        "doesNotCallLive": [
          "X API hide endpoint",
          "Supabase Moderation Queue insert",
          "Telegram sendMessage"
        ]
      },
      "lastValidated": {
        "date": "2026-10-03",
        "execution": "40976"
      }
    },
